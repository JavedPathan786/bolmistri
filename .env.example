# Never put secret keys in variables that start with VITE_.
# Anything with VITE_ is visible to everyone in the browser.

# Later (server side only, e.g. Vercel serverless function):
# SOME_SECRET_API_KEY=

# Later (Supabase public keys are OK in the browser):
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
